  m_text: "\u30FB\u6551\u52A9\u304C\u6765\u308B\u307E\u3067\u306E 20\u5206\u9593
    \u8352\u91CE\u3092\u751F\u304D\u5EF6\u3073\u308C\u3070\u30AF\u30EA\u30A2\u3060\u3088\n\u30FB\u6575\u30E1\u30AB\u3010N.E.K.O.\u3011\u306B\u63A5\u89E6\u3059\u308B\u3068\u30C0\u30E1\u30FC\u30B8\u3092\u53D7\u3051\u308B\u3088\n\u30FB\u6B66\u5668\u306F\u81EA\u52D5\u3067\u653B\u6483\u3059\u308B\u3088\n\u30FBHP\u304C0\u306B\u306A\u308B\u3068\u30B2\u30FC\u30E0\u30AA\u30FC\u30D0\u30FC\u3060\u3088\n\u30FB\u6575\u30E1\u30AB\u3092\u5012\u3059\u3068\u7D4C\u9A13\u5024\u3092\u30C9\u30ED\u30C3\u30D7\u3059\u308B\u3088\n\u30FB\u7D4C\u9A13\u5024\u3092\u96C6\u3081\u308B\u3068LV\u30A2\u30C3\u30D7\u3059\u308B\u3088\n\u30FBLV\u30A2\u30C3\u30D7\u3059\u308B\u3068\u9078\u3070\u308C\u305FUG\u304B\u30891\u3064\u9078\u629E\u3057\u3066\u5F37\u5316\u3067\u304D\u308B\u3088\n\u30FBUG\u306B\u4E0A\u9650\u306F\u306A\u3044\u304B\u3089\u597D\u304D\u306AUG\u3092\u5F37\u5316\u3057\u7D9A\u3051\u3089\u308C\u308B\u3088\n\u30FB\u30D5\u30A3\u30FC\u30EB\u30C9\u306E\u901A\u4FE1\u6A5F\u3092\u624B\u306B\u5165\u308C\u308B\u3068
    \u4EF2\u9593 \u304C\u52A9\u3051\u306B\u6765\u308B\u3088\n\u30FB\u52A0\u5165\u3059\u308B\u4EF2\u9593\u306F\u30E9\u30F3\u30C0\u30E0\u3060\u3088\n\u30FB\u4EF2\u9593\u306F\u305D\u308C\u305E\u308C\u9055\u3063\u305F\u6B66\u5668\u3092\u4F7F\u3046\u3088\n\u30FB\u4E00\u5B9A\u6642\u9593\u3054\u3068\u306B\u30AB\u30FC\u30B4\u304B\u3089\u30A2\u30A4\u30C6\u30E0\u304C\u843D\u3061\u308B\u3088\n\u30FB\u4E2D\u30DC\u30B9
    \u30DC\u30B9 \u306F\u7279\u6B8A\u306A\u5F37\u5316\u30A2\u30A4\u30C6\u30E0\u3092\u843D\u3068\u3059\u3088\n\u30FB\u8996\u8074\u8005\u6570\u3092\u5897\u3084\u3059\u3068\u30EA\u30B6\u30EB\u30C8\u5F8C
    \u5F37\u5316\u30DD\u30A4\u30F3\u30C8 \u304C\u7372\u5F97\u3067\u304D\u308B\u3088\n\u30FB\u5F37\u5316\u30DD\u30A4\u30F3\u30C8\u3092\u4F7F\u3063\u3066
    \u5F37\u5316 \u3059\u308B\u3068\u6709\u5229\u306B\u6226\u3048\u308B\u3088"
