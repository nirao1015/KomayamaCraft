  useSampleQuestsForLayoutPreview: 0
  sampleQuests:
  - id: fish
    title: "\u9B5A\u306E\u7D0D\u5165"
    body: "\u9B5A\u3092\u7D0D\u5165\u3059\u308B\uFF081/20\uFF09\n\u6E2F\u306E\u63B2\u793A\u677F\u3078\u904B\u3076\u3002"
  - id: iron
    title: "\u9244\u9C57\u3092\u96C6\u3081\u308B"
    body: "\u9244\u9C57\uFF083/5\uFF09\n\u71B1\u56A2\u8349\u306E\u56A2\uFF080/2\uFF09\n\u4E0D\u6642\u7740\u8239\u4ED8\u8FD1\u306E\u8CC7\u6E90\u767A\u751F\u70B9\u304B\u3089\u63A1\u53D6\u3059\u308B\u3002"
  - id: report
    title: "\u72B6\u6CC1\u3092\u5831\u544A\u3059\u308B"
    body: "\u63B2\u793A\u677F\u3067\u5831\u544A\u3059\u308B\n\n\u9032\u6357\u30E1\u30E2\uFF1A\n\u30FB\u5468\u8FBA\u306E\u6D77\u3092\u78BA\u8A8D\u3057\u305F\n\u30FB\u5927\u9678\u306E\u5165\u308A\u53E3\u3092\u898B\u3064\u3051\u305F\n\u30FB\u6B21\u306F\u5185\u9678\u306E\u8CC7\u6E90\u3092\u8ABF\u3079\u308B"
  - id: long
    title: "\u9577\u3044\u8AAC\u660E\u306E\u30AF\u30A8\u30B9\u30C8\uFF08\u30B9\u30AF\u30ED\u30FC\u30EB\u78BA\u8A8D\u7528\uFF09"
    body: "\u3053\u308C\u306F\u30B9\u30AF\u30ED\u30FC\u30EB\u78BA\u8A8D\u7528\u306E\u9577\u3044\u672C\u6587\u3067\u3059\u3002\n\u884C1\uFF1A\u5FC5\u8981\u306A\u7D20\u6750\u3092\u96C6\u3081\u308B\n\u884C2\uFF1A\u52A0\u5DE5\u8A2D\u5099\u3067\u7CBE\u88FD\u3059\u308B\n\u884C3\uFF1A\u4FDD\u7BA1\u5EAB\u3078\u904B\u3076\n\u884C4\uFF1A\u7D0D\u54C1\u30AB\u30A6\u30F3\u30C8\u3092\u78BA\u8A8D\u3059\u308B\n\u884C5\uFF1A\u8FFD\u52A0\u306E\u4F9D\u983C\u3092\u53D7\u3051\u308B\n\u884C6\uFF1A\u5730\u56F3\u306E\u672A\u8E0F\u5730\u57DF\u3092\u958B\u304F\n\u884C7\uFF1A\u518D\u78BA\u8A8D\u3057\u3066\u5831\u544A\u3059\u308B\n\u884C8\uFF1A\u5831\u916C\u3092\u53D7\u3051\u53D6\u308B\n\u884C9\uFF1A\u6B21\u306E\u30AF\u30A8\u30B9\u30C8\u3078\u9032\u3080\n\u884C10\uFF1A\u30ED\u30B0\u304C\u534A\u5206\u3092\u8D85\u3048\u305F\u3089\u30B9\u30AF\u30ED\u30FC\u30EB\u3067\u304D\u308B\u3053\u3068"
